# Kopieer naar .env en pas per locatie aan

# P1-kabel op de host; liefst het stabiele by-id pad (ls -l /dev/serial/by-id/)
P1_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXXXXXX-if00-port0

MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=dsmr
MQTT_PASSWORD=geheim

# Uniek per locatie als meerdere meters naar dezelfde broker sturen
MQTT_CLIENT_UNIQ_ID=mqtt-dsmr-thuis
MQTT_TOPIC_PREFIX=dsmr/thuis

LOGLEVEL=INFO
PRODUCTION=true
MQTT_MAXRATE=60
HA_DISCOVERY=true
